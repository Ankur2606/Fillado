# ─────────────────────────────────────────────
# Fillado ET Intelligence Layer — Environment Template
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.
# ─────────────────────────────────────────────

# ── LLM Provider Keys (keep at least one) ────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=...

# Active LLM provider: openai | gemini | deepseek
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ── Neo4j Knowledge Graph ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── Vector Database ──────────────────────────
# Pinecone
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=fillado-embeddings

# Milvus (alternative to Pinecone)
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION_NAME=fillado_embeddings

# Active vector DB backend: pinecone | milvus
VECTOR_DB_BACKEND=pinecone

# ── PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fillado

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application Settings ─────────────────────
APP_ENV=development        # development | staging | production
APP_LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ── ET / NSE Data Sources ────────────────────
ET_MARKETS_BASE_URL=https://economictimes.indiatimes.com/markets
NSE_API_BASE_URL=https://www.nseindia.com/api
